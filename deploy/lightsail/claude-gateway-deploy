#!/usr/bin/env bash
# Forced command for the GitHub Actions deploy key (installed by install-deploy-key.sh as
# /usr/local/bin/claude-gateway-deploy). The key can run only `deploy <commit sha>`, with a tar on stdin
# holding image.tar.gz (`docker save` of claude-proxy:<sha>) and config.toml.
#
# Stop-then-start, since only one process may hold the subscription grant. Before the swap the database
# and config are backed up inside the data volume, and once the old container has stopped the database file
# is copied beside itself (/data/claude_proxy.db.pre-deploy-<stamp>). If the new container doesn't come up
# with a working credential, the previous image and config are put back, and so is that copy: the new image
# may have migrated the database into a shape the old one misreads. The new container may also have rotated
# the grants' refresh tokens, and an older copy of them would break the login, so the credentials are carried
# over from the database being replaced, which stays beside it as /data/claude_proxy.db.failed-<stamp>.
# Backups are in /data/backups for a manual restore.
set -euo pipefail
DIR=${CLAUDE_GATEWAY_DIR:-$HOME/claude-gateway/deploy/lightsail}
VOLUME=claude-gateway_data
KEEP_IMAGES=3
KEEP_BACKUPS=5

read -r CMD SHA EXTRA <<<"${SSH_ORIGINAL_COMMAND:-}"
[[ ${CMD:-} == deploy && ${SHA:-} =~ ^[0-9a-f]{40}$ && -z ${EXTRA:-} ]] \
  || { echo "usage: deploy <40-hex commit sha>, with the payload tar on stdin" >&2; exit 2; }
cd "$DIR"
exec 9>.deploy.lock
flock -n 9 || { echo "another deploy is running" >&2; exit 1; }

WORK=$(mktemp -d -p "$HOME" .claude-gateway-deploy.XXXXXX)   # /tmp is RAM-backed
trap 'rm -rf "$WORK"' EXIT
tar -x -C "$WORK" --no-same-owner --no-same-permissions -f - image.tar.gz config.toml
for f in image.tar.gz config.toml; do [[ -f $WORK/$f && ! -L $WORK/$f ]] || { echo "bad payload: $f" >&2; exit 1; }; done

# The image may carry only the claude-proxy:<sha> tag, so a load can't replace other services' images.
python3 - "$WORK/image.tar.gz" "claude-proxy:$SHA" <<'PY'
import json, sys, tarfile
path, want = sys.argv[1], sys.argv[2]
with tarfile.open(path, "r:gz") as t:
    tags = [tag for m in json.load(t.extractfile("manifest.json")) for tag in (m.get("RepoTags") or [])]
    try:
        index = json.load(t.extractfile("index.json"))
    except KeyError:
        index = {}
names = [n for d in index.get("manifests", []) for k, n in d.get("annotations", {}).items()
         if k in ("io.containerd.image.name", "org.opencontainers.image.ref.name")]
if tags != [want] or any(n not in ("docker.io/library/" + want, want, want.split(":")[1]) for n in names):
    sys.exit(f"image must be tagged exactly {want}, found {tags} {names}")
PY
echo "loading claude-proxy:$SHA"
docker load -q <"$WORK/image.tar.gz"

PREV=$(sed -n 's/^GATEWAY_TAG=//p' .env 2>/dev/null || true)
PREV=${PREV:-latest}
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
in_volume() { docker run --rm -i --network none -v "$VOLUME:/data" "claude-proxy:$PREV" "$@"; }

echo "backing up database and config to /data/backups/$STAMP.*"
in_volume python - "$STAMP" "$KEEP_BACKUPS" <<'PY'
import glob, os, shutil, sqlite3, sys
stamp, keep = sys.argv[1], int(sys.argv[2])
os.makedirs("/data/backups", mode=0o700, exist_ok=True)
db = f"/data/backups/{stamp}.db"
dst = sqlite3.connect(db)
sqlite3.connect("/data/claude_proxy.db").backup(dst)
dst.close()
os.chmod(db, 0o600)
if os.path.exists("/data/config.toml"):
    shutil.copy2("/data/config.toml", f"/data/backups/{stamp}.config.toml")
for old in sorted(glob.glob("/data/backups/*.db"))[:-keep]:
    for f in (old, old[:-3] + ".config.toml"):
        if os.path.exists(f):
            os.remove(f)
PY
in_volume sh -c 'cat >/data/config.toml.new && mv /data/config.toml.new /data/config.toml' <"$WORK/config.toml"

PORT=$(sed -n 's/^port *= *\([0-9][0-9]*\).*/\1/p' "$WORK/config.toml" | head -1)   # [listener] port
PORT=${PORT:-18480}
switch_to() { printf 'GATEWAY_TAG=%s\n' "$1" >.env; docker compose up -d --no-build --force-recreate; }
healthy() {
  local i up=
  for i in $(seq 30); do
    if curl -fsS --max-time 5 -o /dev/null "http://127.0.0.1:$PORT/health"; then up=1; break; fi
    sleep 1
  done
  [[ $up ]] || { echo "gateway did not answer on http://127.0.0.1:$PORT/health within 30 s" >&2; return 1; }
  # Every linked account must be OK, and one not used for a while is refreshed only by the gateway's first poll,
  # so the status is asked again for up to 60 s before it counts as a failure.
  for i in $(seq 12); do
    docker compose exec -T gateway claude-proxy status 2>&1 | grep -v "HTTP Request" >"$WORK/status" || true
    grep -q '^credential: OK' "$WORK/status" && { cat "$WORK/status" >&2; return 0; }
    sleep 5
  done
  cat "$WORK/status" >&2
  echo "credential not OK after 60 s (lines above: which account and why)" >&2
  return 1
}

# A copy of the database as the old container left it, taken while nothing has it open, for the rollback.
PRE=/data/claude_proxy.db.pre-deploy-$STAMP
echo "stopping $PREV and copying the database to $PRE"
docker compose stop gateway
if ! in_volume python - "$PRE" "$KEEP_BACKUPS" <<'PY'
import glob, os, sqlite3, sys
pre, keep = sys.argv[1], int(sys.argv[2])
dst = sqlite3.connect(pre)
sqlite3.connect("/data/claude_proxy.db").backup(dst)
dst.close()
os.chmod(pre, 0o600)
for pattern in ("/data/claude_proxy.db.pre-deploy-*", "/data/claude_proxy.db.failed-*"):
    for old in sorted(glob.glob(pattern))[:-keep]:
        os.remove(old)
PY
then
  echo "could not copy the database; starting $PREV again, nothing deployed" >&2
  in_volume sh -c "[ ! -f /data/backups/$STAMP.config.toml ] || cp /data/backups/$STAMP.config.toml /data/config.toml" || true
  switch_to "$PREV" || true
  exit 1
fi

echo "switching $PREV -> $SHA"
if ! { switch_to "$SHA" && healthy; }; then
  echo "claude-proxy:$SHA is unhealthy; rolling back to $PREV" >&2
  docker compose logs --tail 40 gateway >&2 || true
  docker compose stop gateway || true
  in_volume sh -c "[ ! -f /data/backups/$STAMP.config.toml ] || cp /data/backups/$STAMP.config.toml /data/config.toml" || true
  echo "restoring the database from $PRE (the one $SHA ran on is kept as /data/claude_proxy.db.failed-$STAMP)" >&2
  if in_volume python - "$PRE" "/data/claude_proxy.db.failed-$STAMP" <<'PY'
import os, sqlite3, sys
pre, failed = sys.argv[1], sys.argv[2]
live = "/data/claude_proxy.db"
keep = sqlite3.connect(failed)
sqlite3.connect(live).backup(keep)
keep.close()
os.chmod(failed, 0o600)
dst = sqlite3.connect(live, isolation_level=None)
sqlite3.connect(pre).backup(dst)
# The grants as the new container left them: it may have spent a refresh token the copy still holds.
dst.execute("ATTACH DATABASE ? AS failed", (failed,))
cols = [r[1] for r in dst.execute("PRAGMA main.table_info(credentials)")]
have = {r[1] for r in dst.execute("PRAGMA failed.table_info(credentials)")}
cols = [c for c in cols if c in have]
if cols:
    names = ", ".join(cols)
    dst.execute(f"INSERT OR REPLACE INTO main.credentials({names}) SELECT {names} FROM failed.credentials")
    print(f"carried over {dst.execute('SELECT COUNT(*) FROM failed.credentials').fetchone()[0]} credentials", file=sys.stderr)
dst.execute("DETACH DATABASE failed")
dst.close()
PY
  then
    echo "database restored from $PRE" >&2
  else
    echo "COULD NOT RESTORE THE DATABASE; $PREV starts on the one $SHA migrated. Restore $PRE by hand" >&2
  fi
  { switch_to "$PREV" && healthy; } || echo "ROLLBACK TO $PREV IS ALSO UNHEALTHY; the gateway needs attention" >&2
  exit 1
fi

# Keep the newest few images (always including the live one and the one it replaced) for rollback.
docker image ls claude-proxy --format '{{.Tag}}' | tail -n +$((KEEP_IMAGES + 1)) | while read -r t; do
  [[ $t == "$SHA" || $t == "$PREV" ]] || docker image rm "claude-proxy:$t" >/dev/null || true
done
echo "deployed claude-proxy:$SHA"

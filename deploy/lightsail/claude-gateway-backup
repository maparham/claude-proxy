#!/usr/bin/env bash
# Forced command for the backup key (installed by install-backup-key.sh as
# /usr/local/bin/claude-gateway-backup). The key can run only `backup`, which writes an encrypted copy of
# the database to stdout for the daily job in the private maparham/claude-proxy-backups repo.
#
# The copy is taken with SQLite's backup API (the database runs in WAL mode, so a file copy could be torn),
# held in memory, gzipped, and encrypted with age to the public key in $RECIPIENTS before it leaves the
# box. The box never holds the private key, and the caller can't choose the recipient.
set -euo pipefail
DIR=${CLAUDE_GATEWAY_DIR:-$HOME/claude-gateway/deploy/lightsail}
VOLUME=claude-gateway_data
RECIPIENTS=/usr/local/etc/claude-gateway-backup.age.pub

[[ ${SSH_ORIGINAL_COMMAND:-backup} == backup ]] \
  || { echo "usage: backup (the encrypted copy goes to stdout)" >&2; exit 2; }
[[ -s $RECIPIENTS ]] || { echo "no age recipient in $RECIPIENTS; run install-backup-key.sh" >&2; exit 1; }
[[ ! -t 1 ]] || { echo "refusing to write the encrypted copy to a terminal" >&2; exit 2; }

TAG=$(sed -n 's/^GATEWAY_TAG=//p' "$DIR/.env" 2>/dev/null || true)
docker run --rm -i --pull never --network none -v "$VOLUME:/data" "claude-proxy:${TAG:-latest}" python - <<'PY' |
import gzip, sqlite3, sys
src = sqlite3.connect("file:/data/claude_proxy.db?mode=ro", uri=True)
dst = sqlite3.connect(":memory:")
src.backup(dst)
data = dst.serialize()
if len(data) < 4096:
    sys.exit(f"copy is only {len(data)} bytes")
sys.stdout.buffer.write(gzip.compress(data, mtime=0))
PY
  age -R "$RECIPIENTS"

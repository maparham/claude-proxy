{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "tag": "in",
      "settings": {
        "clients": [
          {
            "id": "<CLIENT_UUID>",
            "flow": "xtls-rprx-vision",
            "email": "gateway-ir"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "dest": "www.microsoft.com:443",
          "serverNames": [
            "www.microsoft.com"
          ],
          "privateKey": "<PRIVATEKEY>",
          "shortIds": [
            "<SHORT_ID>"
          ]
        }
      },
      "sniffing": {
        "enabled": false
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct",
      "settings": {
        "finalRules": [
          {
            "action": "allow",
            "network": "tcp",
            "ip": [
              "127.0.0.1"
            ],
            "port": "18480,18481"
          }
        ]
      }
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "rules": [
      {
        "inboundTag": [
          "in"
        ],
        "ip": [
          "127.0.0.1"
        ],
        "port": "18480,18481",
        "outboundTag": "direct"
      },
      {
        "inboundTag": [
          "in"
        ],
        "outboundTag": "block"
      }
    ]
  }
}

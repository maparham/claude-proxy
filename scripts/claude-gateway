#!/usr/bin/env bash
# Point this machine's Claude Code at a claude-proxy gateway, or back at its own login.
#
#   claude-gateway on --url https://claude.example.com   # gclaude (the default), first time: authorize in the browser
#   claude-gateway on --url https://claude.example.com --key sk-proxy-...   # or with a key from the admin
#   claude-gateway on                # later
#   claude-gateway on --login        # authorize this computer again, e.g. after it was removed in the dashboard
#   claude-gateway off               # removes whichever of gclaude and global mode is set up
#   claude-gateway status
#   claude-gateway on --global --url https://claude.example.com --key sk-proxy-...   # global mode: plain claude itself
#   claude-gateway on --own-login    # global mode keeping this machine's claude.ai login (Claude in Chrome, connectors)
#   claude-gateway on --key-only     # global mode, back to sending only the gateway key
#   claude-gateway off --global
#   claude-gateway on --opencode --url https://claude.example.com --routes-key sk-proxy-r-...   # OpenCode, first time
#   claude-gateway on --opencode     # later: refreshes the model list
#   claude-gateway off --opencode
#   claude-gateway on --gclaude / off --gclaude      # gclaude, explicitly
#
# Global mode (--global) edits ~/.claude itself. Its key-only mode (the default there) sets ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN in the "env" block of
# ~/.claude/settings.json. Claude Code then has no claude.ai login, so claude.ai connectors and Claude in
# Chrome are off; the script sets "disableClaudeAiConnectors" (unless already set) to silence the warning.
# Own-login mode is for a machine that is itself signed in to a Claude subscription (the owner's): it sets
# ANTHROPIC_BASE_URL and sends the gateway key in ANTHROPIC_CUSTOM_HEADERS, so Claude Code keeps its own
# login for Claude in Chrome and connectors while requests still go through, and are metered by, the gateway.
# `on` also installs a UserPromptSubmit hook (statusline.sh --warn) that shows a warning when a limit is at 80%,
# and a statusline showing the user's gateway limits, unless one is already set; then it prints
# how to add them to that one instead. gclaude's statusline shows the limits and then the user's own statusline
# from ~/.claude, if they have one (statusline.sh --then). `off` removes exactly what `on` added and leaves every other setting
# alone. The URL, key, mode and a copy of statusline.sh are kept in ~/.config/claude-gateway/ (client.json is
# mode 600). Start a new Claude Code session after switching.
# --opencode acts on OpenCode only (third-party models such as Muse; Anthropic accepts the subscription only from
# Claude Code). With the routes-only key the admin issues (`claude-proxy user routes-key`), it adds a "gateway"
# provider to ~/.config/opencode/opencode.json and a muse subagent; `off --opencode` removes exactly those. The key
# is kept in ~/.config/claude-gateway/routes.key (mode 600) and opencode.json only refers to that file.
# gclaude (the default, or --gclaude) leaves ~/.claude alone and installs a `gclaude` command in ~/.local/bin instead: it runs Claude Code with
# CLAUDE_CONFIG_DIR=~/.config/claude-gateway/claude, whose settings.json gets the key-only setup above, so `claude`
# keeps this machine's own login and both can run at once. CLAUDE.md, agents, commands, skills, plugins (with the
# list of enabled ones), user-scope MCP servers, each project's memory and plain claude's sessions (so gclaude's
# /resume lists them) from ~/.claude are shared, refreshed each time gclaude starts (gclaude-sync.py); settings,
# login, prompt history and the sessions started in gclaude stay separate.
# gclaude's own /usage shows the gateway line instead of Claude Code's (which can't see the gateway), with no model
# call. Its /logout signs this computer out: it revokes the key when it is this computer's own and removes it here;
# gclaude then refuses to start until `claude-gateway on --login`. `off --gclaude` removes the command, the links, /usage and its settings, and keeps gclaude's history.
# Without --key (and none saved for that URL), `on` authorizes in the browser: it opens the dashboard (--dashboard,
# else the URL with claude. replaced by claude-dash.) at a code, and once you click Authorize there the dashboard
# hands this computer a key of its own. Over SSH it only prints the link and the code, to open on any device.
# gclaude and global mode share the saved URL and key: --url/--key given to either replace them for both. On a
# machine already in global mode, a bare `on` refreshes global mode rather than switching it to gclaude.
set -euo pipefail

SETTINGS=${CLAUDE_SETTINGS:-$HOME/.claude/settings.json}
CLIENT=${CLAUDE_GATEWAY_CLIENT:-$HOME/.config/claude-gateway/client.json}

STATUSLINE=$(dirname "$CLIENT")/statusline.sh
ROUTES_KEY=$(dirname "$CLIENT")/routes.key
OPENCODE_DIR=${CLAUDE_GATEWAY_OPENCODE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}   # where OpenCode reads its global config
GCLAUDE_DIR=${CLAUDE_GATEWAY_GCLAUDE_DIR:-$(dirname "$CLIENT")/claude}   # gclaude's CLAUDE_CONFIG_DIR
GCLAUDE=${CLAUDE_GATEWAY_BIN:-$HOME/.local/bin}/gclaude
GCLAUDE_MARK="# Installed by claude-gateway on --gclaude."
GCLAUDE_SYNC=$(dirname "$CLIENT")/gclaude-sync.py   # a copy, like statusline.sh, so the repository can move

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit "${1:-0}"; }

save_client() {   # url key [dashboard]
  mkdir -p "$(dirname "$CLIENT")"
  ( umask 077; python3 - "$CLIENT" "$@" <<'EOF'
import json, os, sys
path, url, key = sys.argv[1], sys.argv[2].rstrip("/"), sys.argv[3]
dash = sys.argv[4] if len(sys.argv) > 4 and sys.argv[4] else url.replace("://claude.", "://claude-dash.", 1)
c = json.load(open(path)) if os.path.exists(path) else {}
c.update({"url": url, "key": key, "dashboard": dash.rstrip("/")})
json.dump(c, open(path, "w"), indent=2)
EOF
  )
  chmod 600 "$CLIENT"
}

authorize() {   # url dashboard: prints the key the dashboard hands this computer once someone authorizes it there
  python3 - "$@" <<'EOF'
import json, os, shutil, socket, subprocess, sys, time
url, dash = sys.argv[1], sys.argv[2]
say = lambda m: print(m, file=sys.stderr, flush=True)

def post(path, body):   # via curl, which uses the system's certificates (some Pythons have none)
    r = subprocess.run(["curl", "-sS", "--max-time", "15", "-X", "POST", "-H", "content-type: application/json",
                        "--data-binary", "@-", "-w", "\n%{http_code}", dash + path],
                       input=json.dumps(body), capture_output=True, text=True)
    text, _, code = r.stdout.rpartition("\n")
    if r.returncode or not code.isdigit():
        raise OSError(r.stderr.strip() or "no answer")
    try:
        data = json.loads(text)
    except ValueError:
        data = {}
    return int(code), data if isinstance(data, dict) else {}

try:
    code, s = post("/api/device/start", {"label": socket.gethostname().split(".")[0]})
except OSError as e:
    sys.exit(f"Can't reach the dashboard at {dash}: {e}")
if code != 200 or "device_code" not in s:
    hint = f" (is {dash} this gateway's dashboard? Give it with --dashboard)" if code == 404 else ""
    sys.exit(f"The dashboard at {dash} can't authorize this computer: {s.get('error') or 'HTTP %d' % code}{hint}")
link = s["verification_uri_complete"]
say(f"To connect this computer, open {link}")
say(f"and check that it shows the code {s['user_code']}.")
opener = os.environ.get("CLAUDE_GATEWAY_OPEN")
if opener is None and not os.environ.get("SSH_CONNECTION"):
    opener = shutil.which("open" if sys.platform == "darwin" else "xdg-open")
if opener and subprocess.run([opener, link], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
    say("It is open in your browser.")
say("Waiting for you to authorize it there...")
interval, deadline = float(s.get("interval", 3)), time.time() + float(s.get("expires_in", 600))
while time.time() < deadline:
    time.sleep(interval)
    try:
        code, r = post("/api/device/token", {"device_code": s["device_code"]})
    except OSError:
        continue   # a blip; keep waiting
    if code >= 500 or code == 429:
        continue   # e.g. the gateway restarting behind its proxy; the approval is still there
    if code == 200 and r.get("key"):
        say(f"Authorized as {r.get('user', '?')}.")
        print(r["key"])
        sys.exit(0)
    err = r.get("error")
    if err == "slow_down":
        interval += 2
    elif err != "authorization_pending":
        sys.exit({"access_denied": "Cancelled in the browser; nothing was changed.",
                  "expired_token": "The code expired. Run the command again for a new one."}.get(err, f"Authorization failed: {err or code}"))
sys.exit("The code expired. Run the command again for a new one.")
EOF
}

dashboard_for() {   # url: the dashboard saved for it, else the usual claude. -> claude-dash. naming
  if [ "$(field url)" = "${1%/}" ] && [ -n "$(field dashboard)" ]; then field dashboard; else echo "${1/:\/\/claude./://claude-dash.}"; fi
}

field() { python3 -c 'import json,os,sys; c=json.load(open(sys.argv[1])) if os.path.exists(sys.argv[1]) else {}; print(c.get(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else ""))' "$CLIENT" "$@"; }

set_mode() {
  python3 -c 'import json,sys; p=sys.argv[1]; c=json.load(open(p)); c["mode"]=sys.argv[2]; json.dump(c, open(p,"w"), indent=2)' "$CLIENT" "$1"
}

src_dir() {   # the directory this script really lives in (through any symlink)
  dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
}

install_statusline() {   # copy statusline.sh from beside this script next to client.json
  local src
  src=$(src_dir)/statusline.sh
  if [ -f "$src" ]; then cp "$src" "$STATUSLINE" && chmod 755 "$STATUSLINE"; fi
}

edit_settings() {   # on|off [settings.json scope]. Scope "gclaude" keeps its own record in client.json and is always key-only.
  local settings=${2:-$SETTINGS}
  mkdir -p "$(dirname "$settings")"
  [ -f "$settings" ] || echo '{}' > "$settings"
  cp -p "$settings" "$settings.bak-claude-gateway"
  python3 - "$1" "$settings" "$CLIENT" "$STATUSLINE" "${3:-global}" "$SETTINGS" <<'EOF'
import json, os, shlex, sys, tempfile
mode, settings, client, statusline, scope, own_settings = sys.argv[1:]
s = json.load(open(settings))
env = s.setdefault("env", {})
c = json.load(open(client)) if os.path.exists(client) else {}
st = c   # what this command added, so `off` removes exactly that; gclaude's own settings keep a separate record
if scope == "gclaude":
    st = c["gclaude"] = c["gclaude"] if isinstance(c.get("gclaude"), dict) else {}
ours = lambda v: isinstance(v, str) and v.lower().startswith("x-gateway-key:")

if mode == "on" and "ANTHROPIC_CUSTOM_HEADERS" in env and not ours(env["ANTHROPIC_CUSTOM_HEADERS"]):
    sys.exit("ANTHROPIC_CUSTOM_HEADERS is already set in %s by something else; leaving everything as it is." % settings)

for k in ("ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_GATEWAY_DASHBOARD"):
    env.pop(k, None)
if ours(env.get("ANTHROPIC_CUSTOM_HEADERS")):
    del env["ANTHROPIC_CUSTOM_HEADERS"]
if st.pop("added_disable_connectors", False):
    s.pop("disableClaudeAiConnectors", None)
line_cmd = shlex.quote(statusline)
ours_line = lambda v: isinstance(v, dict) and isinstance(v.get("command"), str) and (
    v["command"] == line_cmd or v["command"].startswith(line_cmd + " --then "))
if st.pop("added_statusline", False) and ours_line(s.get("statusLine")):
    del s["statusLine"]

# The limit warning (statusline.sh --warn): our own group in the UserPromptSubmit hooks, beside any others.
warn_cmd = line_cmd + " --warn"
ours_hook = lambda g: isinstance(g, dict) and any(isinstance(h, dict) and h.get("command") == warn_cmd for h in g.get("hooks", []))
if st.pop("added_warn_hook", False) and isinstance(s.get("hooks"), dict):
    submit = s["hooks"].get("UserPromptSubmit")
    if isinstance(submit, list):
        groups = [g for g in submit if not ours_hook(g)]
        if groups:
            s["hooks"]["UserPromptSubmit"] = groups
        else:
            s["hooks"].pop("UserPromptSubmit", None)
    if not s["hooks"]:
        del s["hooks"]

if mode == "on":
    env.update({"ANTHROPIC_BASE_URL": c["url"], "CLAUDE_GATEWAY_DASHBOARD": c["dashboard"]})
    if c.get("mode") == "own-login" and scope == "global":
        env["ANTHROPIC_CUSTOM_HEADERS"] = "x-gateway-key: " + c["key"]
    else:
        env["ANTHROPIC_AUTH_TOKEN"] = c["key"]
        if "disableClaudeAiConnectors" not in s:
            s["disableClaudeAiConnectors"] = True
            st["added_disable_connectors"] = True
    if os.path.exists(statusline):
        if "statusLine" not in s:
            s["statusLine"] = {"type": "command", "command": line_cmd, "refreshInterval": 30}
            # gclaude keeps the user's own statusline (from ~/.claude) after the gateway line, rather than replacing it.
            try:
                own = json.load(open(own_settings)).get("statusLine") if scope == "gclaude" else None
            except (OSError, ValueError):
                own = None
            if isinstance(own, dict) and own.get("type") == "command" and isinstance(own.get("command"), str) and not ours_line(own):
                s["statusLine"] = {**own, "command": line_cmd + " --then " + shlex.quote(own["command"])}
                s["statusLine"].setdefault("refreshInterval", 30)
            st["added_statusline"] = True
        elif not ours_line(s["statusLine"]):
            print("You already have a statusline, so it was left as it is. To show your gateway limits in it too,\n"
                  "add the output of this command to it: " + line_cmd)
        hooks = s.setdefault("hooks", {})
        if isinstance(hooks, dict) and isinstance(hooks.setdefault("UserPromptSubmit", []), list):
            if not any(ours_hook(g) for g in hooks["UserPromptSubmit"]):
                hooks["UserPromptSubmit"].append({"hooks": [{"type": "command", "command": warn_cmd, "timeout": 10}]})
                st["added_warn_hook"] = True
if not env:
    del s["env"]

fd, tmp = tempfile.mkstemp(dir=os.path.dirname(settings))
with os.fdopen(fd, "w") as f:
    json.dump(s, f, indent=2)
    f.write("\n")
os.chmod(tmp, os.stat(settings).st_mode & 0o777)
os.replace(tmp, settings)
if c:
    json.dump(c, open(client, "w"), indent=2)
EOF
}

current() {   # prints "<url> <mode>" from settings, or nothing
  [ -f "$SETTINGS" ] && python3 -c '
import json, sys
env = json.load(open(sys.argv[1])).get("env", {})
if env.get("ANTHROPIC_BASE_URL"):
    print(env["ANTHROPIC_BASE_URL"], "own-login" if "x-gateway-key" in env.get("ANTHROPIC_CUSTOM_HEADERS", "").lower() else "key-only")' "$SETTINGS" || true
}

preflight() {   # mode: the gateway answers and accepts the key the way that mode sends it
  local url auth code out
  url=$(field url)
  if [ "$1" = own-login ]; then auth="x-gateway-key: $(field key)"; else auth="Authorization: Bearer $(field key)"; fi
  out=$(mktemp)
  code=$(printf '%s\n' "$auth" | curl -sS -o "$out" -w '%{http_code}' --max-time 15 -H @- -H "anthropic-version: 2023-06-01" \
         "$url/v1/models" 2>/dev/null) || code=000   # the key goes on stdin: in curl's arguments, `ps` would show it
  if [ "$code" != 200 ]; then
    echo "The gateway at $url did not accept the key (HTTP $code); leaving Claude Code as it is." >&2
    head -c 400 "$out" >&2; echo >&2; rm -f "$out"; exit 1
  fi
  rm -f "$out"
}

has_own_login() {   # best effort: a claude.ai login stored by Claude Code on this machine
  security find-generic-password -s "Claude Code-credentials" >/dev/null 2>&1 || [ -s "$HOME/.claude/.credentials.json" ]
}

preflight_routes() {   # url key out: the gateway takes the OpenCode key the way OpenCode sends it; its model list goes to out
  local code
  code=$(printf 'x-api-key: %s\n' "$2" | curl -sS -o "$3" -w '%{http_code}' --max-time 15 -H @- -H "anthropic-version: 2023-06-01" \
         "$1/v1/models" 2>/dev/null) || code=000
  if [ "$code" != 200 ]; then
    echo "The gateway at $1 did not accept the OpenCode key (HTTP $code); leaving OpenCode as it is." >&2
    head -c 400 "$3" >&2; echo >&2; rm -f "$3"; exit 1
  fi
}

opencode_edit() {   # on <models.json> | off. `on` takes the URL and key from CG_URL and CG_KEY.
  python3 - "$1" "$OPENCODE_DIR" "$CLIENT" "$ROUTES_KEY" "$(src_dir)/../examples/opencode/muse.md" "${2:-}" <<'EOF'
import hashlib, json, os, shutil, sys, tempfile
mode, oc_dir, client, key_file, agent_src, models_file = sys.argv[1:7]
key_file = os.path.abspath(key_file)
conf = os.path.join(oc_dir, "opencode.json")      # never opencode.jsonc: OpenCode merges the two
agent = os.path.join(oc_dir, "agents", "muse.md")
SCHEMA = "https://opencode.ai/config.json"

def digest(p):
    with open(p, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()

def write_json(path, data, perms=None):
    path = os.path.realpath(path)   # a symlinked opencode.json (dotfiles-style) keeps pointing at its target
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.chmod(tmp, perms if perms is not None else (os.stat(path).st_mode & 0o777 if os.path.exists(path) else 0o644))
    os.replace(tmp, path)

conf = os.path.realpath(conf)   # resolve once: reads, writes and the "delete only if we created it" removal all
                                 # then act on the real file, so a dotfiles-style symlink survives on/off.

c = json.load(open(client)) if os.path.exists(client) else {}
if not isinstance(c, dict):
    c = {}
rec = c.get("opencode") if isinstance(c.get("opencode"), dict) else {}
try:
    s = json.load(open(conf)) if os.path.exists(conf) else None
except ValueError:
    sys.exit(f"{conf} is not plain JSON (comments or a trailing comma?), so it was left as it is. "
             "Add the gateway provider by hand, or move the comments to opencode.jsonc.")
created = s is None
if created:
    s = {"$schema": SCHEMA}
elif not isinstance(s, dict):
    sys.exit(f"{conf} is not a JSON object, so it was left as it is. Add the gateway provider by hand.")
providers = s.get("provider") if isinstance(s.get("provider"), dict) else {}

if mode == "on":
    url, key = os.environ["CG_URL"].rstrip("/"), os.environ["CG_KEY"]
    if "provider" in s and not isinstance(s["provider"], dict):
        sys.exit(f'{conf} has a "provider" field that is not a JSON object, so it was left as it is. '
                  "Add the gateway provider by hand.")
    if "gateway" in providers and not rec.get("added_provider"):
        sys.exit(f"{conf} already has a provider named 'gateway' that claude-gateway did not add; left as it is.")
    model_data = json.load(open(models_file)).get("data", [])
    if any(str(m.get("id", "")).startswith("claude-") for m in model_data):
        sys.exit("The gateway answered with Claude models for this key; that looks like a Claude Code key, not "
                 f"an OpenCode routes key. {conf} was left as it is.")
    models = {}
    for m in model_data:
        entry = {"name": m.get("display_name") or m["id"]}
        if m.get("max_input_tokens") and m.get("max_tokens"):
            entry["limit"] = {"context": m["max_input_tokens"], "output": m["max_tokens"]}
        models[m["id"]] = entry
    if not models:
        print("The gateway has no third-party models for this key yet, so the gateway provider is empty. Rerun "
              "'claude-gateway on --opencode' after the admin adds a route.", file=sys.stderr)

    # Record that we own this provider (and its URL, kept separately from Claude Code's own) BEFORE touching
    # opencode.json: if a later step fails (routes.key, opencode.json or the agent copy), a rerun of `on
    # --opencode` sees added_provider already true and repairs rather than refusing, and `off --opencode` can
    # always find its own record to undo.
    # had_provider: whether opencode.json had a "provider" key before we ever touched it. A record from before
    # this field existed (added_provider already true, had_provider absent) can't tell empty-from-absent anymore,
    # so it falls back to the old behaviour (drop "provider" entirely on off) rather than guessing wrong.
    had_provider = rec["had_provider"] if "had_provider" in rec else (not rec.get("added_provider") and "provider" in s)
    rec = {"added_provider": True, "created_file": rec.get("created_file", created),
           "agent_sha256": rec.get("agent_sha256"), "url": url, "had_provider": had_provider,
           "created_agents_dir": rec.get("created_agents_dir", False)}
    c["opencode"] = rec
    os.makedirs(os.path.dirname(client), exist_ok=True)
    write_json(client, c, 0o600)

    s.setdefault("provider", {})["gateway"] = {
        "npm": "@ai-sdk/anthropic", "name": "Claude gateway",
        "options": {"baseURL": url + "/v1", "apiKey": "{file:" + key_file + "}"},
        "models": models}
    os.makedirs(os.path.dirname(key_file), exist_ok=True)
    old = os.umask(0o077)
    try:
        with open(key_file, "w") as f:
            f.write(key)                           # no newline: OpenCode sends the file's content as the key
    finally:
        os.umask(old)
    os.chmod(key_file, 0o600)
    os.makedirs(oc_dir, exist_ok=True)
    write_json(conf, s)
    if not os.path.lexists(agent) and not os.path.exists(agent_src):   # lexists: a broken symlink already "exists"
        print(f"The muse agent was not installed: {agent_src} is missing (run claude-gateway from its repository).",
              file=sys.stderr)
    elif not os.path.lexists(agent):
        try:
            if not os.path.lexists(os.path.dirname(agent)):
                rec["created_agents_dir"] = True
            os.makedirs(os.path.dirname(agent), exist_ok=True)
            shutil.copyfile(agent_src, agent)
            rec["agent_sha256"] = digest(agent)
        except OSError as e:
            print(f"Could not install the muse agent at {agent} ({e}); "
                  "the gateway provider was installed without it.", file=sys.stderr)
else:
    removed_provider = False
    if rec.get("added_provider") and "gateway" in providers:
        del providers["gateway"]
        removed_provider = True
        if not providers and not rec.get("had_provider"):
            s.pop("provider", None)   # spec 4: a config that never had "provider" comes back without one
        if rec.get("created_file") and s == {"$schema": SCHEMA}:
            os.remove(conf)
        else:
            write_json(conf, s)
    gateway_present = False   # re-read: our own removal above may have changed this, and we may not own it at all
    if os.path.exists(conf):
        try:
            cur = json.load(open(conf))
            gateway_present = isinstance(cur, dict) and "gateway" in (cur.get("provider") or {})
        except ValueError:
            gateway_present = True   # can't tell; be conservative and keep the key file
    sha = rec.get("agent_sha256")
    if sha and os.path.exists(agent) and digest(agent) == sha:   # untouched since `on` copied it
        os.remove(agent)
    agents_dir = os.path.dirname(agent)
    if rec.get("created_agents_dir") and os.path.isdir(agents_dir) and not os.listdir(agents_dir):
        os.rmdir(agents_dir)
    had_key = os.path.exists(key_file)
    if gateway_present:
        if had_key:
            print(f"{conf} still has a 'gateway' provider that this command did not remove; "
                  "the OpenCode key file was left in place.", file=sys.stderr)
        summary = f"{conf} still has a 'gateway' provider that this command did not remove." + \
                  (" The OpenCode key file was kept." if had_key else "")
    elif had_key:
        os.remove(key_file)
        summary = ("OpenCode no longer uses the gateway; the key file was deleted." if removed_provider else
                   f"The OpenCode key file was deleted (no 'gateway' provider was found in {conf}).")
    elif removed_provider:
        summary = "OpenCode no longer uses the gateway."
    else:
        summary = "OpenCode had no gateway provider set up; nothing to undo."
    print(summary)
    c.pop("opencode", None)
if c:
    os.makedirs(os.path.dirname(client), exist_ok=True)
    write_json(client, c, 0o600)
elif os.path.exists(client):
    os.remove(client)   # nothing else was configured
EOF
}

opencode_url() {   # the URL last used for OpenCode's provider, kept separately from Claude Code's own URL
  python3 -c 'import json,os,sys
c = json.load(open(sys.argv[1])) if os.path.exists(sys.argv[1]) else {}
oc = c.get("opencode") if isinstance(c.get("opencode"), dict) else {}
print(oc.get("url") or "")' "$CLIENT"
}

opencode_on() {   # url-or-empty key-or-empty; empty means the saved one
  local url key models
  url=$1
  [ -n "$url" ] || url=$(opencode_url)
  [ -n "$url" ] || url=$(field url)
  url=${url%/}
  key=${2:-$(cat "$ROUTES_KEY" 2>/dev/null || true)}
  [ -n "$url" ] || { echo "No gateway URL yet: claude-gateway on --opencode --url <url> --routes-key <key>" >&2; exit 1; }
  [ -n "$key" ] || { echo "No OpenCode key yet: claude-gateway on --opencode --routes-key <key> (the admin issues it)" >&2; exit 1; }
  case "$key" in
    sk-proxy-r-*) ;;
    *) echo "This is a Claude Code key; ask the admin for an OpenCode key (claude-proxy user routes-key)." >&2; exit 1 ;;
  esac
  models=$(mktemp)
  preflight_routes "$url" "$key" "$models"
  export CG_URL=$url CG_KEY=$key
  if ! opencode_edit on "$models"; then rm -f "$models"; exit 1; fi
  rm -f "$models"
  echo "OpenCode now has a 'gateway' provider for $url (third-party models only). Start a new OpenCode session to pick it up."
}

opencode_state() {
  if [ -f "$OPENCODE_DIR/opencode.json" ] && python3 -c 'import json,sys; sys.exit(0 if "gateway" in (json.load(open(sys.argv[1])).get("provider") or {}) else 1)' "$OPENCODE_DIR/opencode.json" 2>/dev/null; then
    echo "opencode: gateway provider installed"
  else
    echo "opencode: not set up"
  fi
}

gclaude_ours() { [ -f "$GCLAUDE" ] && [ ! -L "$GCLAUDE" ] && grep -qxF "$GCLAUDE_MARK" "$GCLAUDE"; }
gclaude_free() { gclaude_ours || { [ ! -e "$GCLAUDE" ] && [ ! -L "$GCLAUDE" ]; } || { echo "$GCLAUDE already exists and claude-gateway did not install it; left as it is." >&2; exit 1; } }

gclaude_files() {   # on|off: the gclaude command, the links to ~/.claude, its /usage, /account and /logout commands, and a first-run state file
  python3 - "$1" "$CLIENT" "$GCLAUDE_DIR" "$GCLAUDE" "$GCLAUDE_MARK" "$(dirname "$SETTINGS")" "$HOME/.claude.json" "$GCLAUDE_SYNC" "$STATUSLINE" <<'EOF'
import atexit, json, os, shlex, sys, tempfile
mode, client, gdir, launcher, mark, shared, own_state, sync, statusline = sys.argv[1:]
SHARED = ("CLAUDE.md", "agents", "skills")   # commands/ is gclaude's own folder: see USAGE below
c = json.load(open(client)) if os.path.exists(client) else {}
rec = c["gclaude"] = c["gclaude"] if isinstance(c.get("gclaude"), dict) else {}
cmds, own_cmds = os.path.join(gdir, "commands"), os.path.join(shared, "commands")
# Claude Code's own /usage can't see the gateway. This command takes its place in gclaude only; the limit-warning
# hook (statusline.sh --warn) blocks the prompt and shows the gateway line, so the text below reaches the model
# only if that hook is missing.
# /account runs statusline.sh --account and a small model call repeats its line: a hook's reply would read as an
# error. When that call can't be made (a limit reached, the gateway down), the hook answers /account instead.
# /logout takes the place of Claude Code's own, which can't sign out of the gateway: the hook answers it, as the key
# it removes is the one a model call would need.
account_cmd = f"sh {shlex.quote(statusline)} --account"
COMMANDS = {"usage": f"""---
description: Your gateway limits and usage
disable-model-invocation: true
---
<!-- {mark} -->
The claude-gateway hook that answers /usage did not run. Tell the user, in one sentence, that their gateway limits
are on the status line and on the dashboard, and that `claude-gateway on --gclaude` reinstalls the hook. Use no tools.
""", "account": f"""---
description: Your gateway account and a link to the dashboard
allowed-tools: Bash({account_cmd})
model: haiku
disable-model-invocation: true
---
<!-- {mark} -->
!`{account_cmd}`

Repeat the line above to the user exactly as it is, and nothing else. Use no tools.
""", "logout": f"""---
description: Sign this computer out of the gateway
disable-model-invocation: true
---
<!-- {mark} -->
The claude-gateway hook that signs gclaude out did not run, so nothing was changed. Tell the user, in one sentence,
that `claude-gateway on --gclaude` reinstalls the hook and `claude-gateway off --gclaude` removes gclaude with its key.
Use no tools.
"""}
cmd_file = lambda name: os.path.join(cmds, name + ".md")
ours_cmd = lambda name: os.path.isfile(cmd_file(name)) and not os.path.islink(cmd_file(name)) and mark in open(cmd_file(name)).read()

@atexit.register   # the record is written even when a step below fails, so `off --gclaude` can undo what was done
def save():
    if isinstance(rec.get("links"), set):
        rec["links"] = sorted(rec["links"])
    if c or os.path.exists(client):
        json.dump(c, open(client, "w"), indent=2)

if mode == "on":
    links = rec["links"] = set(rec.get("links", []))
    if "commands" in links:   # an older gclaude linked the whole folder; it is gclaude's own folder now
        if os.path.islink(cmds) and os.readlink(cmds) == own_cmds:
            os.remove(cmds)
        links.discard("commands")
    for name in SHARED:
        src, dst = os.path.join(shared, name), os.path.join(gdir, name)
        if os.path.islink(dst) and os.readlink(dst) == src:   # ours, perhaps from a run that failed before recording it
            links.add(name)
        elif os.path.exists(src) and not os.path.lexists(dst):   # never replace what the gclaude dir already has
            links.add(name)
            os.symlink(src, dst)
    for name, text in COMMANDS.items():
        path = cmd_file(name)
        if os.path.islink(cmds):
            print(f"{cmds} is a link, so gclaude's /{name} was not added there.", file=sys.stderr)
        elif os.path.lexists(path) and not ours_cmd(name):
            print(f"{path} is your own, so it was left as it is; /{name} in gclaude runs it instead of the gateway's.",
                  file=sys.stderr)
        else:
            os.makedirs(cmds, exist_ok=True)
            with open(path, "w") as f:
                f.write(text)
    state = os.path.join(gdir, ".claude.json")   # Claude Code's own state; seeded once so it skips its welcome screens
    if not os.path.lexists(state):
        seed = {"hasCompletedOnboarding": True}
        try:
            theme = json.load(open(own_state)).get("theme")
            if theme:
                seed["theme"] = theme
        except (OSError, ValueError, AttributeError):
            pass
        with open(state, "w") as f:
            json.dump(seed, f)
    os.makedirs(os.path.dirname(launcher), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(launcher))   # replaced, never written through a link
    with os.fdopen(fd, "w") as f:
        f.write("#!/bin/sh\n"
                "# gclaude: Claude Code through the claude-proxy gateway, with its own settings and history in the\n"
                "# CLAUDE_CONFIG_DIR below. Plain `claude` keeps this machine's own login.\n"
                f"{mark}\n"
                "# Remove it with: claude-gateway off --gclaude\n"
                "command -v claude >/dev/null 2>&1 || { echo 'gclaude: Claude Code (claude) is not installed or not on PATH' >&2; exit 127; }\n"
                f"CLAUDE_CONFIG_DIR={shlex.quote(gdir)}\n"
                "export CLAUDE_CONFIG_DIR\n"
                "grep -q '\"ANTHROPIC_AUTH_TOKEN\"' \"$CLAUDE_CONFIG_DIR/settings.json\" 2>/dev/null ||"
                " { echo 'gclaude: signed out (/logout); to sign in again: claude-gateway on --login' >&2; exit 1; }\n"
                "# Share commands, plugins, MCP servers, memory and sessions from ~/.claude (see gclaude-sync.py); never stops gclaude.\n"
                f"python3 {shlex.quote(sync)} sync \"$CLAUDE_CONFIG_DIR\" {shlex.quote(shared)} 2>/dev/null\n"
                'exec claude "$@"\n')
    os.chmod(tmp, 0o755)
    os.replace(tmp, launcher)
else:
    for name in rec.get("links", []):
        dst = os.path.join(gdir, name)
        if os.path.islink(dst) and os.readlink(dst) == os.path.join(shared, name):
            os.remove(dst)
    if os.path.isdir(cmds) and not os.path.islink(cmds):
        for name in COMMANDS:
            if ours_cmd(name):
                os.remove(cmd_file(name))
        if not os.listdir(cmds):
            os.rmdir(cmds)
    c.pop("gclaude", None)
EOF
}

gclaude_on() {
  gclaude_free
  [ -n "$(field key)" ] || { echo "No gateway configured yet: claude-gateway on --gclaude --url <url> --key <key>" >&2; exit 1; }
  preflight key-only
  install_statusline
  mkdir -p "$GCLAUDE_DIR"
  chmod 700 "$GCLAUDE_DIR"   # its settings.json holds the gateway key
  [ -f "$GCLAUDE_DIR/settings.json" ] || ( umask 077; echo '{}' > "$GCLAUDE_DIR/settings.json" )
  edit_settings on "$GCLAUDE_DIR/settings.json" gclaude
  chmod 600 "$GCLAUDE_DIR/settings.json" "$GCLAUDE_DIR/settings.json.bak-claude-gateway"
  cp "$(src_dir)/gclaude-sync.py" "$GCLAUDE_SYNC"
  gclaude_files on
  python3 "$GCLAUDE_SYNC" sync "$GCLAUDE_DIR" "$(dirname "$SETTINGS")" || true   # now, so the first start has it all
  echo "gclaude now runs Claude Code through the gateway at $(field url); plain 'claude' is unchanged."
  case ":$PATH:" in *":$(dirname "$GCLAUDE"):"*) ;; *) echo "Add $(dirname "$GCLAUDE") to your PATH to run gclaude." ;; esac
}

gclaude_off() {
  if ! gclaude_ours && [ ! -f "$GCLAUDE_DIR/settings.json" ]; then echo "gclaude was not set up; nothing to undo."; return; fi
  python3 "$(src_dir)/gclaude-sync.py" unsync "$GCLAUDE_DIR" "$(dirname "$SETTINGS")" || true   # the rest of off still runs
  rm -f "$GCLAUDE_SYNC"
  if [ -f "$GCLAUDE_DIR/settings.json" ]; then
    edit_settings off "$GCLAUDE_DIR/settings.json" gclaude
    rm -f "$GCLAUDE_DIR/settings.json.bak-claude-gateway"   # the copy from before `off` still holds the key
  fi
  gclaude_files off
  if gclaude_ours; then
    rm -f "$GCLAUDE"
    echo "gclaude is removed. Its history and sessions are still in $GCLAUDE_DIR; delete that folder to drop them."
  else
    echo "gclaude's gateway settings are removed. $GCLAUDE was not installed by claude-gateway, so it was left as it is."
  fi
}

gclaude_set_up() {   # its command, or its record in client.json (what `off --gclaude` would undo)
  gclaude_ours || python3 -c 'import json,os,sys; c=json.load(open(sys.argv[1])) if os.path.exists(sys.argv[1]) else {}
sys.exit(0 if isinstance(c.get("gclaude"), dict) else 1)' "$CLIENT"
}

gclaude_state() {
  if gclaude_ours; then echo "gclaude: installed ($GCLAUDE)"; else echo "gclaude: not set up"; fi
}

cmd=${1:-status}; shift || true
case "$cmd" in
  on)
    url="" key="" dash="" mode="" opencode="" rkey="" gclaude="" global="" login=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --url) url=$2; shift 2 ;;
        --key) key=$2; shift 2 ;;
        --dashboard) dash=$2; shift 2 ;;
        --global) global=1; shift ;;
        --own-login) mode=own-login; global=1; shift ;;
        --key-only) mode=key-only; global=1; shift ;;
        --opencode) opencode=1; shift ;;
        --routes-key) rkey=$2; shift 2 ;;
        --gclaude) gclaude=1; shift ;;
        --login) login=1; shift ;;
        *) usage 1 ;;
      esac
    done
    if [ -n "$opencode" ]; then
      [ -z "$key$dash$mode$gclaude$global$login" ] || { echo "--opencode takes only --url and --routes-key; set up Claude Code with a separate 'claude-gateway on'." >&2; exit 1; }
      opencode_on "$url" "$rkey"
      exit 0
    fi
    [ -z "$rkey" ] || { echo "--routes-key goes with --opencode." >&2; exit 1; }
    case "$key" in
      sk-proxy-r-*) echo "This is an OpenCode key; Claude Code needs your Claude Code key." >&2; exit 1 ;;
    esac
    if [ -n "$gclaude" ] && [ -n "$global" ]; then
      [ -z "$mode" ] || { echo "gclaude always sends the gateway key (key-only mode); --own-login and --key-only are for global mode (claude-gateway on --global)." >&2; exit 1; }
      echo "Choose one: --gclaude (the default) or --global." >&2; exit 1
    fi
    # gclaude is the default. A bare `on` on a machine already in global mode keeps refreshing that, so nobody is
    # switched without asking.
    if [ -z "$gclaude$global" ]; then
      if [ -n "$(current)" ]; then
        global=1
        echo "This machine is in global mode (plain 'claude' uses the gateway), so that is what 'on' refreshes. To use"
        echo "gclaude instead: claude-gateway off --global, then claude-gateway on."
      else
        gclaude=1
      fi
    fi
    [ -z "$key" ] || [ -z "$login" ] || { echo "Choose one: --key or --login." >&2; exit 1; }
    if [ -n "$key" ]; then
      url=${url:-$(field url)}
      [ -n "$url" ] || { echo "Give --url with --key the first time." >&2; exit 1; }
      [ -z "$gclaude" ] || gclaude_free
      save_client "$url" "$key" "$dash"
    elif [ -n "$url$login" ] || [ -z "$(field key)" ]; then
      url=${url:-$(field url)}
      [ -n "$url" ] || { echo "No gateway configured yet: claude-gateway on --url <gateway url>" >&2; exit 1; }
      if [ -z "$login" ] && [ -n "$(field key)" ] && [ "$(field url)" = "${url%/}" ]; then
        [ -z "$dash" ] || save_client "$url" "$(field key)" "$dash"   # already connected there: keep its key
      else
        [ -z "$gclaude" ] || gclaude_free
        dash=${dash:-$(dashboard_for "$url")}
        key=$(authorize "$url" "${dash%/}") || exit 1
        save_client "$url" "$key" "$dash"
      fi
    fi
    if [ -n "$gclaude" ]; then gclaude_on; exit 0; fi
    [ -n "$(field key)" ] || { echo "No gateway configured yet: claude-gateway on --global --url <url> --key <key>" >&2; exit 1; }
    mode=${mode:-$(field mode key-only)}
    if [ "$mode" = own-login ] && ! has_own_login; then
      echo "Own-login mode needs this machine signed in to Claude Code with a subscription (run 'claude', then /login)," >&2
      echo "or use --key-only." >&2; exit 1
    fi
    preflight "$mode"
    set_mode "$mode"
    install_statusline
    edit_settings on
    echo "Claude Code now uses the gateway at $(field url) ($(field mode key-only) mode). Start a new session to pick it up."
    ;;
  off)
    case "${1:-}" in
      --opencode)
        shift
        [ $# -eq 0 ] || usage 1
        opencode_edit off
        exit 0
        ;;
      --gclaude)
        shift
        [ $# -eq 0 ] || usage 1
        gclaude_off
        exit 0
        ;;
      --global)
        shift
        [ $# -eq 0 ] || usage 1
        edit_settings off
        echo "Claude Code uses this machine's own login again. Start a new session to pick it up."
        ;;
      "")   # whichever of global mode and gclaude is set up
        has_gclaude=""
        if gclaude_set_up; then has_gclaude=1; fi
        if [ -n "$(current)" ] && [ -n "$has_gclaude" ]; then
          echo "Both global mode and gclaude are set up: claude-gateway off --global, or off --gclaude." >&2; exit 1
        elif [ -n "$(current)" ]; then
          edit_settings off
          echo "Claude Code uses this machine's own login again. Start a new session to pick it up."
        elif [ -n "$has_gclaude" ]; then
          gclaude_off
        else
          echo "Neither gclaude nor global mode is set up; nothing to undo."
        fi
        ;;
      *) usage 1 ;;
    esac
    ;;
  status)
    read -r url mode <<<"$(current)" || true
    if [ -z "${url:-}" ]; then echo "off: Claude Code uses this machine's own login"; gclaude_state; opencode_state; exit 0; fi
    echo "on: $url ($mode mode)"
    if curl -fsS --max-time 10 "$url/health" >/dev/null; then echo "gateway: reachable"; else echo "gateway: NOT reachable (Claude Code will fail; 'claude-gateway off' to fall back)"; fi
    if [ -f "$CLIENT" ]; then
      line=$(printf 'Authorization: Bearer %s\n' "$(field key)" | curl -fsS --max-time 10 -H @- "$(field dashboard)/api/me/status?format=text" 2>/dev/null || true)
      [ -n "$line" ] && echo "usage: $line"
    fi
    gclaude_state
    opencode_state
    ;;
  -h|--help|help) usage 0 ;;
  *) usage 1 ;;
esac
